generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime? // Required for NextAuth
  name                String?
  title               String?   @default("Traveler")
  avatar              String?
  image               String?   // NextAuth uses 'image' field
  bio                 String?
  onboardingCompleted Boolean   @default(false)
  preferences         Json?     // Stores UI state like impact slider value
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // NextAuth relations
  accounts            Account[]
  sessions            Session[]
  
  // App relations
  memories            Memory[]
  people              Person[]
  habits              Habit[]
  biographyChapters   BiographyChapter[]
  personalityTests    PersonalityTest[]
  compassTodos        CompassTodo[]
  financialSnapshots  FinancialSnapshot[]
  userPreferences     UserPreferences?
  memorySuggestions   MemorySuggestion[]
  oracleConversations OracleConversation[]
  futureVisualizations FutureVisualization[]
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OracleConversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        String   @default("text") // "text" | "voice"
  messages    Json     // Array of { role, content, timestamp }
  summary     String?  // AI-generated summary or first message snippet
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId, createdAt])
}

model Memory {
  id          String   @id @default(cuid())
  content     String   // The text or caption
  type        String   @default("text") // text, image, voice, video
  mediaUrl    String?  // Primary media URL (backward compatibility)
  
  memoryDate  DateTime // The actual date of the memory (can be in past)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Location Data
  locationName String?
  latitude     Float?
  longitude    Float?
  
  // Metadata
  title       String?   // Auto-generated if not provided
  weather     Json?     // Stores { temp: number, condition: string, icon: string }

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  people      Person[] // Implicit many-to-many
  media       MemoryMedia[]
}

model MemoryMedia {
  id        String   @id @default(cuid())
  url       String
  type      String   // image, video, audio
  memoryId  String
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model BiographyChapter {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  order     Int
  startDate DateTime? // Optional: cover a range
  endDate   DateTime?
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  lastGeneratedAt DateTime @default(now())
}

model Person {
  id           String   @id @default(cuid())
  name         String
  relationship String?
  avatar       String?
  color        String?  @default("bg-blue-500")
  
  // AI Insight
  aiSummary    String?  @db.Text
  lastAnalyzedAt DateTime?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  memories     Memory[] // Implicit many-to-many

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Habit {
  id          String   @id @default(cuid())
  title       String
  frequency   String   // daily, weekly
  streak      Int      @default(0)
  lastCompletedAt DateTime?
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PersonalityTest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // MBTI Results
  mbtiType    String   // e.g., "INFJ"
  description String   @db.Text
  traits      Json     // Detailed breakdown
  
  // Test metadata
  testType    String   @default("mbti") // Future: enneagram, big5, etc.
  responses   Json     // Store raw quiz responses
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId, createdAt])
}

model CompassTodo {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  task          String
  description   String?  @db.Text
  category      String   // Career, Relationships, Health, Personal Development
  timeframe     String   // today, week, month
  status        String   @default("pending") // pending, completed, dismissed
  source        String   @default("ai") // ai, manual, calendar
  
  // Calendar integration
  googleEventId String?  @unique
  dueDate       DateTime?
  
  completedAt   DateTime?
  dismissedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId, status, timeframe])
}

model FinancialSnapshot {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Financial data
  dataJson      Json     // Stores all financial inputs
  
  // AI Analysis
  healthScore   Int?     // 0-100
  aiReport      String?  @db.Text
  recommendations Json?  // Array of advice items
  
  createdAt     DateTime @default(now())
  
  @@index([userId, createdAt])
}

model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Calendar
  googleCalendarEnabled Boolean  @default(false)
  googleRefreshToken    String?  @db.Text
  googleAccessToken     String?  @db.Text
  
  // Financial
  monthlyInvestment     Int      @default(100) // In dollars

  expectedReturn        Float    @default(0.07) // 7% default
  impactValue           Int      @default(50)   // 0-100 slider value
  
  // Horoscope
  lastHoroscopeFetch    DateTime?
  cachedHoroscope       String?  @db.Text
  
  // AI Recommendations Cache
  personalityRecsGeneratedAt DateTime?
  financialRecsGeneratedAt   DateTime?
  
  // Notification Settings
  emailNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(false)
  weeklyDigest          Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AIRecommendation {
  id          String   @id @default(cuid())
  userId      String
  
  // Type: "personality" or "financial"
  type        String
  
  // Recommendation data
  category    String
  task        String
  description String?  @db.Text
  
  // Status
  status      String   @default("pending") // pending, accepted, dismissed
  
  createdAt   DateTime @default(now())
  
  @@index([userId, type, status])
}

model MemorySuggestion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content     String   // The suggestion text
  context     Json?    // Metadata about what influenced this suggestion
  
  generatedAt DateTime @default(now())
  expiresAt   DateTime // Set to end of day when generated
  used        Boolean  @default(false)
  
  @@index([userId, expiresAt])
  @@index([generatedAt])
}

model FutureVisualization {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // User photo and generated images (for future use)
  originalPhotoUrl String?
  scenarioImages   Json?    // Array of 3 scenario image URLs
  
  // 3 Scenarios: optimistic, current, warning
  scenarios        Json     // Array of 3 scenario objects with life path breakdowns
  
  // AI-generated narrative and wisdom
  narrative        String?  @db.Text
  wisdomContent    String?  @db.Text
  
  // Data snapshot used for generation
  dataSnapshot     Json?
  
  createdAt        DateTime @default(now())
  
  @@index([userId, createdAt])
}
