generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  title               String?   @default("Traveler")
  avatar              String?
  bio                 String?
  onboardingCompleted Boolean   @default(false)
  preferences         Json?     // Stores UI state like impact slider value
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memories            Memory[]
  people              Person[]
  habits              Habit[]
  biographyChapters   BiographyChapter[]
}

model Memory {
  id          String   @id @default(cuid())
  content     String   // The text or caption
  type        String   @default("text") // text, image, voice, video
  mediaUrl    String?  // Primary media URL (backward compatibility)
  
  memoryDate  DateTime // The actual date of the memory (can be in past)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Location Data
  locationName String?
  latitude     Float?
  longitude    Float?
  
  // Metadata
  title       String?   // Auto-generated if not provided
  weather     Json?     // Stores { temp: number, condition: string, icon: string }

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  people      Person[] // Implicit many-to-many
  media       MemoryMedia[]
}

model MemoryMedia {
  id        String   @id @default(cuid())
  url       String
  type      String   // image, video, audio
  memoryId  String
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model BiographyChapter {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  order     Int
  startDate DateTime? // Optional: cover a range
  endDate   DateTime?
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  lastGeneratedAt DateTime @default(now())
}

model Person {
  id           String   @id @default(cuid())
  name         String
  relationship String?
  avatar       String?
  color        String?  @default("bg-blue-500")
  
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  memories     Memory[] // Implicit many-to-many

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Habit {
  id          String   @id @default(cuid())
  title       String
  frequency   String   // daily, weekly
  streak      Int      @default(0)
  lastCompletedAt DateTime?
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
